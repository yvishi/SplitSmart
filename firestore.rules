rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Ensure the user is signed in
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // ─── USERS ────────────────────────────────────────────────────────────────
    // Users can write (update) only their own profile.
    // Users can READ any other user's basic profile (name, phone) — required for
    // contact search and group member display.
    match /users/{uid} {
      allow read: if isAuthenticated();   // needed for contacts search & member display
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    // ─── GROUPS ───────────────────────────────────────────────────────────────
    // A group document can be read if the user is in its memberUids array.
    match /groups/{groupId} {
      function isGroupMember() {
        return request.auth.uid in resource.data.memberUids;
      }
      
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && isGroupMember();
      allow update: if isAuthenticated() && isGroupMember();
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;

      // ─── EXPENSES (Subcollection) ───────────────────────────────────────────
      // Write: user must be authenticated and their UID must be in the expense's participantUids.
      // Read: user must be authenticated and be a member of the parent group.
      match /expenses/{expenseId} {
        function isParentGroupMember() {
          let parentGroup = get(/databases/$(database)/documents/groups/$(groupId));
          return request.auth.uid in parentGroup.data.memberUids;
        }

        // For create: just check the user is listed as a participant (avoids extra get() in batch)
        allow create: if isAuthenticated()
            && request.auth.uid in request.resource.data.participantUids;

        // For reads and updates: verify group membership
        allow read, update, delete: if isAuthenticated() && isParentGroupMember();
      }
    }

    // ─── SETTLEMENTS ──────────────────────────────────────────────────────────
    // A settlement can only be read/updated by the payer or the receiver.
    match /settlements/{settlementId} {
      function isPartyToSettlement() {
        return request.auth.uid == resource.data.fromUid 
            || request.auth.uid == resource.data.toUid;
      }

      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated() && isPartyToSettlement();
      allow delete: if false; // Settlements shouldn't be deleted, only 'cancelled'
    }

    // ─── COLLECTION GROUP: expenses ───────────────────────────────────────────
    // Required for collectionGroup('expenses') queries (e.g. recent expenses on home screen).
    // Firestore collection group queries need a top-level wildcard match.
    // We check participation directly in the document data.
    match /{path=**}/expenses/{expenseId} {
      allow read: if request.auth != null
          && request.auth.uid in resource.data.participantUids;
    }
  }
}
